#!/usr/bin/env bash
set -euo pipefail

# Fast local guard only. Full static analysis, Rector, Pest, and browser tests
# belong in CI or explicit verification commands such as composer test:push.

staged_files=$(git diff --cached --name-only --diff-filter=ACMR)
staged_php_files=$(printf '%s\n' "$staged_files" | awk '/\.php$/')

if [[ -n "$staged_php_files" ]]; then
    echo "Running fast pre-commit checks..."

    while IFS= read -r file; do
        [[ -z "$file" || ! -f "$file" ]] && continue

        if ! output=$(php -l "$file" 2>&1); then
            echo "PHP syntax error in $file:"
            echo "$output"
            exit 1
        fi
    done <<< "$staged_php_files"

    echo "PHP lint passed"

    if [[ -x vendor/bin/pint ]] && ! vendor/bin/pint --dirty --blade --test --format=txt; then
        echo "Commit blocked: Pint found formatting issues."
        echo "Run 'composer lint' to fix them."
        exit 1
    fi

    echo "Pint passed"
fi

staged_js_files=$(printf '%s\n' "$staged_files" | awk '/\.(js|mjs)$/')

if [[ -n "$staged_js_files" ]]; then
    echo "Running JavaScript lint..."
    printf '%s\n' "$staged_js_files" | xargs ./node_modules/.bin/eslint
    printf '%s\n' "$staged_js_files" | xargs ./node_modules/.bin/prettier --check
fi
