#!/usr/bin/env bash
set -euo pipefail

if [[ "${SKIP_PRE_PUSH_CHECKS:-0}" == "1" ]]; then
    echo "Skipping pre-push checks (SKIP_PRE_PUSH_CHECKS=1)."
    exit 0
fi

# Git passes one line per pushed ref on stdin (and only once, so read it all first):
# <local ref> <local sha> <remote ref> <remote sha>
# Deleting a branch or pushing a tag publishes no new branch code, so it needs no checks.
needs_checks=0

while read -r local_ref local_sha remote_ref remote_sha || [[ -n "${local_ref}" ]]; do
    if [[ "${local_sha}" =~ ^0+$ ]]; then
        continue
    fi

    if [[ "${local_ref}" == refs/tags/* ]]; then
        continue
    fi

    needs_checks=1
done

if [[ "${needs_checks}" == "0" ]]; then
    echo "Only branch deletions or tags are being pushed; skipping pre-push checks."
    exit 0
fi

echo "Running Ringside pre-push checks..."
composer test:push
