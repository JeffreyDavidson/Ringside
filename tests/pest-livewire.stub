<?php

namespace Pest\Livewire;

use Livewire\Component;
use Livewire\Features\SupportTesting\Testable;

/**
 * Preserve the supplied component class through Pest Livewire 5.0's helper.
 *
 * @template TComponent of Component
 *
 * @param array<array-key, mixed> $params
 * @return ($name is class-string<TComponent> ? Testable<TComponent> : Testable<Component>)
 */
function livewire(string $name, array $params = []) {}

namespace Livewire;

abstract class Component {}

namespace Livewire\Features\SupportTesting;

/**
 * @template TComponent of \Livewire\Component
 * @mixin \Illuminate\Testing\TestResponse
 */
class Testable {}
