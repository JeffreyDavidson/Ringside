<?php

namespace {

use Pest\Browser\Api\ArrayablePendingAwaitablePage;
use Pest\Browser\Api\PendingAwaitablePage;

/**
 * @template TUrl of array<int, string>|string
 * @param TUrl $url
 * @param array<string, mixed> $options
 * @return (TUrl is array<int, string> ? ArrayablePendingAwaitablePage : PendingAwaitablePage)
 */
function visit(array|string $url, array $options = []) {}

}

namespace Pest\Browser\Api {

/**
 * AwaitableWebpage maps fluent Webpage results back to its own wrapper.
 *
 * @mixin Webpage
 * @method AwaitableWebpage wait(int|float|null $seconds = null)
 */
final readonly class AwaitableWebpage {}

/**
 * @mixin Webpage|AwaitableWebpage
 * @method AwaitableWebpage wait(int|float|null $seconds = null)
 */
final class PendingAwaitablePage {}

/**
 * @mixin PendingAwaitablePage
 * @method AwaitableWebpage wait(int|float|null $seconds = null)
 */
final readonly class On {}

final readonly class Webpage {}

final class ArrayablePendingAwaitablePage {}

}
