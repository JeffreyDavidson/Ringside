parameters:
    paths:
        - tests

    level: 9

    stubFiles:
        - stubs/Illuminate/Http/Response.stub
        - stubs/Illuminate/Testing/TestResponse.stub
        - stubs/Symfony/Component/HttpFoundation/Response.stub

    excludePaths:
        - bootstrap/cache
        - storage

    ignoreErrors:
        - identifier: pest.expectation.redundant

    type_coverage:
        param: 0
        return: 0
        property: 0

    tmpDir: storage/framework/cache/phpstan-pest
