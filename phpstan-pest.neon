parameters:
  level: 9

  paths:
    - tests

  stubFiles:
    - stubs/Illuminate/Http/Response.stub
    - stubs/Illuminate/Testing/TestResponse.stub
    - stubs/Symfony/Component/HttpFoundation/Response.stub

  excludePaths:
    - bootstrap/cache
    - storage

  ignoreErrors:
    - identifier: pest.expectation.redundant

  # Type coverage is enforced against application code by Pest's dedicated command.
  # Disable the PHPStan extension's default threshold while analyzing tests.
  type_coverage:
    param: 0
    return: 0
    property: 0

  tmpDir: storage/framework/cache/phpstan-pest
