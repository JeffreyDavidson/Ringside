{
    "private": true,
    "type": "module",
    "engines": {
        "node": ">=24"
    },
    "scripts": {
        "dev": "vite",
        "build": "vite build",
        "build:analyze": "ANALYZE=true vite build",
        "lint": "eslint resources/js/**/*.js",
        "lint:fix": "eslint resources/js/**/*.js --fix",
        "format": "prettier --write \"resources/js/**/*.js\"",
        "format:check": "prettier --check \"resources/js/**/*.js\"",
        "prepare": "git config core.hooksPath .githooks"
    },
    "lint-staged": {
        "resources/js/**/*.js": [
            "eslint --fix",
            "prettier --write"
        ],
        "resources/views/**/*.blade.php": [
            "vendor/bin/pint --blade"
        ]
    },
    "devDependencies": {
        "@eslint/js": "^9.32.0",
        "@tailwindcss/postcss": "^4.1.0",
        "@typescript-eslint/eslint-plugin": "^8.38.0",
        "@typescript-eslint/parser": "^8.38.0",
        "autoprefixer": "^10.4.16",
        "axios": "^1.20.0",
        "concurrently": "^9.0.1",
        "eslint": "^9.32.0",
        "eslint-config-prettier": "^10.1.8",
        "eslint-plugin-prettier": "^5.5.3",
        "laravel-vite-plugin": "^2.0.0",
        "lint-staged": "^16.1.2",
        "playwright": "^1.62.1",
        "postcss": "^8.4.33",
        "prettier": "^3.9.6",
        "prettier-plugin-blade": "^3.2.2",
        "prettier-plugin-tailwindcss": "^0.8.1",
        "rollup-plugin-visualizer": "^6.0.3",
        "tailwindcss": "^4.1.0",
        "vite": "^7.0.7",
        "vite-bundle-analyzer": "^1.1.0"
    },
    "dependencies": {
        "@alpinejs/ui": "^3.14.8",
        "glob": "^11.0.3"
    },
    "$schema": "https://www.schemastore.org/package.json"
}
