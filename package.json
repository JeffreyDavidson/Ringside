{
    "private": true,
    "type": "module",
    "engines": {
        "node": ">=24"
    },
    "scripts": {
        "dev": "vite",
        "build": "vite build",
        "build:analyze": "ANALYZE=true vite build",
        "lint": "eslint resources/js/**/*.js vite.config.mjs eslint.config.js",
        "lint:fix": "eslint resources/js/**/*.js vite.config.mjs eslint.config.js --fix",
        "format": "prettier --write \"resources/js/**/*.js\" vite.config.mjs eslint.config.js prettier.config.mjs",
        "format:check": "prettier --check \"resources/js/**/*.js\" vite.config.mjs eslint.config.js prettier.config.mjs",
        "prepare": "git config core.hooksPath .githooks"
    },
    "devDependencies": {
        "@eslint/js": "^9.32.0",
        "@tailwindcss/vite": "^4.3.3",
        "axios": "^1.20.0",
        "concurrently": "^9.0.1",
        "eslint": "^9.32.0",
        "laravel-vite-plugin": "^2.0.0",
        "playwright": "^1.62.1",
        "prettier": "^3.9.6",
        "prettier-plugin-blade": "^3.2.2",
        "prettier-plugin-tailwindcss": "^0.8.1",
        "rollup-plugin-visualizer": "^6.0.3",
        "tailwindcss": "^4.1.0",
        "vite": "^7.0.7"
    },
    "dependencies": {
        "@alpinejs/ui": "^3.14.8",
        "glob": "^11.0.3"
    },
    "$schema": "https://www.schemastore.org/package.json"
}
